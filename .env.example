# Copy this file to .env and fill in your values
# cp .env.example .env

# ========== SERVER ==========
PORT=3000
NODE_ENV=development

# ========== DATABASE ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=skillup_db

# ========== SESSION ==========
SESSION_SECRET=your_super_secret_key_change_this_in_production

# ========== MIDTRANS PAYMENT (Sandbox for testing) ==========
# Get your key at: https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-your_key_here
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_key_here
MIDTRANS_IS_PRODUCTION=false

# ========== APP SETTINGS ==========
APP_URL=http://localhost:3000
PLATFORM_COMMISSION=0.30
